<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.ejerciciointegradorclase.controller.MainController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>

    <top>
        <Label text="Listado de Inventario" style="-fx-font-size: 18px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <TableView fx:id="inventarioTable" prefHeight="360.0" prefWidth="640.0">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="60.0"/>
                <TableColumn fx:id="nombreColumn" text="Nombre" prefWidth="220.0"/>
                <TableColumn fx:id="fechaColumn" text="Fecha" prefWidth="160.0"/>
                <TableColumn fx:id="estadoColumn" text="Estado" prefWidth="140.0"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10.0"/>
            </padding>
            <Button text="Nuevo" onAction="#onNuevo"/>
            <Button text="Refrescar" onAction="#onRefrescar"/>
            <Button text="Cerrar sesión" onAction="#onCerrarSesion"/>
            <Label fx:id="statusLabel"/>
        </HBox>
    </bottom>
</BorderPane>
